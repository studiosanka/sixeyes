<?xml version="1.0"?>
<!--
  SixEyes arm — PLACEHOLDER description.

  Every link dimension and mass in this file is an estimate, not a
  measurement — no mechanical CAD exists in this repo yet (see
  docs/V1_TODO.md). Link lengths are chosen so the shoulder-to-gripper-tip
  reach sums to the 500 mm design target (upper_arm 220mm + forearm 180mm +
  wrist/gripper 100mm); revise all of this once real CAD lands.

  Kinematic chain is 4 actuated joints, matching the real mechanism, NOT
  the 4 CAN nodes. Shoulder L/R are two motors in lockstep driving ONE
  physical joint (see docs/protocols/CAN_MESSAGE_PROTOCOL.md, section 2),
  not two separate DOF. The wrist/gripper stage is 3 open-loop servo joints.

  Stepper joint effort limits (waist/shoulder/elbow) come from the 1:25
  cycloidal reduction torque budget in
  docs/hardware/v1/GEARBOX_TORQUE_BUDGET.md (~9.75 N.m output, before
  further real-world derating). Servo joint limits use representative
  MG996R figures, matching the legacy 0-180 degree range in
  firmware/legacy/*/servo_control.
-->
<robot name="sixeyes" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="stepper_effort" value="9.75" />   <!-- N.m, see GEARBOX_TORQUE_BUDGET.md -->
  <xacro:property name="stepper_velocity" value="1.0" />  <!-- rad/s placeholder; 1:25 reduction is slow -->
  <xacro:property name="servo_effort" value="1.2" />      <!-- N.m, representative MG996R stall torque estimate -->
  <xacro:property name="servo_velocity" value="3.0" />    <!-- rad/s, placeholder -->

  <material name="sixeyes_grey">
    <color rgba="0.55 0.55 0.58 1.0" />
  </material>
  <material name="sixeyes_dark">
    <color rgba="0.15 0.15 0.17 1.0" />
  </material>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}" />
      <inertia
        ixx="${mass/12.0*(y*y+z*z)}" ixy="0.0" ixz="0.0"
        iyy="${mass/12.0*(x*x+z*z)}" iyz="0.0"
        izz="${mass/12.0*(x*x+y*y)}" />
    </inertial>
  </xacro:macro>

  <!-- Base -->
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.06" length="0.02" /></geometry>
      <material name="sixeyes_dark" />
    </visual>
    <collision>
      <geometry><cylinder radius="0.06" length="0.02" /></geometry>
    </collision>
    <xacro:box_inertial mass="0.4" x="0.12" y="0.12" z="0.02" />
  </link>

  <!-- Waist (Base CAN node) -->
  <link name="waist_link">
    <visual>
      <origin xyz="0 0 0.05" />
      <geometry><cylinder radius="0.045" length="0.10" /></geometry>
      <material name="sixeyes_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0.05" />
      <geometry><cylinder radius="0.045" length="0.10" /></geometry>
    </collision>
    <xacro:box_inertial mass="0.3" x="0.09" y="0.09" z="0.10" />
  </link>

  <joint name="waist_joint" type="revolute">
    <parent link="base_link" />
    <child link="waist_link" />
    <origin xyz="0 0 0.01" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="${stepper_effort}" velocity="${stepper_velocity}" />
  </joint>

  <!-- Shoulder: lockstep Shoulder L/R CAN nodes drive this ONE joint -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.11 0 0" rpy="0 1.5708 0" />
      <geometry><cylinder radius="0.03" length="0.22" /></geometry>
      <material name="sixeyes_grey" />
    </visual>
    <collision>
      <origin xyz="0.11 0 0" rpy="0 1.5708 0" />
      <geometry><cylinder radius="0.03" length="0.22" /></geometry>
    </collision>
    <xacro:box_inertial mass="0.25" x="0.22" y="0.06" z="0.06" />
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="waist_link" />
    <child link="upper_arm_link" />
    <origin xyz="0 0 0.10" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.5708" upper="1.5708" effort="${stepper_effort}" velocity="${stepper_velocity}" />
  </joint>

  <!-- Elbow -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0.09 0 0" rpy="0 1.5708 0" />
      <geometry><cylinder radius="0.025" length="0.18" /></geometry>
      <material name="sixeyes_grey" />
    </visual>
    <collision>
      <origin xyz="0.09 0 0" rpy="0 1.5708 0" />
      <geometry><cylinder radius="0.025" length="0.18" /></geometry>
    </collision>
    <xacro:box_inertial mass="0.18" x="0.18" y="0.05" z="0.05" />
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link" />
    <child link="forearm_link" />
    <origin xyz="0.22 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.618" upper="2.618" effort="${stepper_effort}" velocity="${stepper_velocity}" />
  </joint>

  <!-- Wrist pitch: open-loop servo -->
  <link name="wrist_pitch_link">
    <visual>
      <geometry><box size="0.04 0.04 0.04" /></geometry>
      <material name="sixeyes_dark" />
    </visual>
    <collision>
      <geometry><box size="0.04 0.04 0.04" /></geometry>
    </collision>
    <xacro:box_inertial mass="0.05" x="0.04" y="0.04" z="0.04" />
  </link>

  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="forearm_link" />
    <child link="wrist_pitch_link" />
    <origin xyz="0.18 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <!-- 0-180 deg range, matching legacy ServoManager DEGREES_MIN/MAX -->
    <limit lower="0" upper="3.14159" effort="${servo_effort}" velocity="${servo_velocity}" />
  </joint>

  <!-- Wrist yaw: open-loop servo -->
  <link name="wrist_yaw_link">
    <visual>
      <geometry><box size="0.03 0.03 0.03" /></geometry>
      <material name="sixeyes_dark" />
    </visual>
    <collision>
      <geometry><box size="0.03 0.03 0.03" /></geometry>
    </collision>
    <xacro:box_inertial mass="0.05" x="0.03" y="0.03" z="0.03" />
  </link>

  <joint name="wrist_yaw_joint" type="revolute">
    <parent link="wrist_pitch_link" />
    <child link="wrist_yaw_link" />
    <origin xyz="0.04 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="3.14159" effort="${servo_effort}" velocity="${servo_velocity}" />
  </joint>

  <!-- Gripper: open-loop servo -->
  <link name="gripper_link">
    <visual>
      <geometry><box size="0.06 0.03 0.03" /></geometry>
      <material name="sixeyes_grey" />
    </visual>
    <collision>
      <geometry><box size="0.06 0.03 0.03" /></geometry>
    </collision>
    <xacro:box_inertial mass="0.08" x="0.06" y="0.03" z="0.03" />
  </link>

  <joint name="gripper_joint" type="revolute">
    <parent link="wrist_yaw_link" />
    <child link="gripper_link" />
    <origin xyz="0.03 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <!-- open/close range, placeholder, not a real 0-180 sweep like pitch/yaw -->
    <limit lower="0" upper="1.0472" effort="${servo_effort}" velocity="${servo_velocity}" />
  </joint>

  <!-- Design-target payload: 500g at the gripper tip, per the 500g/500mm
       design target in GEARBOX_TORQUE_BUDGET.md. Fixed joint so it loads
       gravity/torque correctly in simulation; remove or comment out for
       an unloaded (empty gripper) test case. -->
  <link name="payload_link">
    <visual>
      <geometry><sphere radius="0.025" /></geometry>
      <material name="sixeyes_dark" />
    </visual>
    <xacro:box_inertial mass="0.5" x="0.05" y="0.05" z="0.05" />
  </link>

  <joint name="payload_joint" type="fixed">
    <parent link="gripper_link" />
    <child link="payload_link" />
    <origin xyz="0.05 0 0" rpy="0 0 0" />
  </joint>

  <!-- ros2_control interfaces: position command in, position/velocity state out,
       for every actuated joint. Limits mirror each joint's <limit> element above. -->
  <ros2_control name="SixEyesSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="waist_joint">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="shoulder_joint">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">1.5708</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position">
        <param name="min">-2.618</param>
        <param name="max">2.618</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="wrist_pitch_joint">
      <command_interface name="position">
        <param name="min">0</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="wrist_yaw_joint">
      <command_interface name="position">
        <param name="min">0</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="gripper_joint">
      <command_interface name="position">
        <param name="min">0</param>
        <param name="max">1.0472</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>

  <!-- gz_ros2_control plugin: runs a controller_manager inside the Gazebo
       process itself, loaded from sixeyes_controllers.yaml (joint_state_broadcaster
       + arm_controller). update_rate there matches CONTROL_LOOP_HZ (250) from
       docs/protocols/CAN_MESSAGE_PROTOCOL.md's resolved control-loop decision,
       so the sim paces itself the same as real v1 firmware is meant to. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find sixeyes_description)/config/sixeyes_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>

	(text "MCU: ESP32-C3-MINI-1 (castellated, 3.3 V, integrated 4 MB flash + PCB antenna)\nADC: GPIO0–5 → POT1–POT6 (ADC1 only, no ADC2)\nUART1: GPIO7 TX (→ follower RX) / GPIO6 RX (← follower TX)\nUSB flashing: native USB Serial/JTAG — GPIO18 (D−) / GPIO19 (D+) → USB-C D−/D+, no bridge chip\nBoot mode: hold S1 (GPIO9 low) + press/release S2 (EN low) → release S1\nRC filter: 1 kΩ series + 100 nF to GND per ADC channel (~1.6 kHz cutoff)\nPower: USB-C VBUS → AMS1117-3.3 → +3V3_LOGIC\nPot connectors: JST XH 3-pin, order = [3V3 | WIPER | GND]\nUART connector: JST XH 4-pin, order = [GND | LEADER_TX | LEADER_RX | 3V3]"
		(exclude_from_sim no)
		(at 23.368 175.514 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d3ee3590-6527-48ed-8a24-5c46ddc8eeed")
	)
